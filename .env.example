# Convex Manager Environment Variables

# --- Ports ---
# The port the frontend dashboard will run on (Default: 8080)
FRONTEND_PORT=8080

# Host port the backend API is published on (Default: 3001).
# The backend always listens on 3001 inside its container; this only changes the host mapping.
BACKEND_PORT=3001

# Docker network that project containers join (Default: convex-manager).
# Set it to your proxy's network (e.g. pangolin) so the proxy can reach project containers by name.
# PROJECTS_NETWORK=convex-manager

# --- Security ---
# Secret used to sign JWT tokens. CHANGE THIS IN PRODUCTION!
JWT_SECRET=super_secret_jwt_key_change_in_production

# --- Database ---
# Credentials for the PostgreSQL database
DB_USER=postgres
DB_PASSWORD=convex_manager_secret
DB_NAME=convex_manager_db

# --- Registration & Auth ---
# Set to 'true' to allow anyone to register an account.
# If 'false', only admins can invite new users.
ALLOW_REGISTRATION=false

# --- Email / SMTP Settings (Required for Invitations & Password Resets) ---
# The base URL of your Convex Manager installation (used in email links)
APP_URL=http://localhost:8080

# Your SMTP server details
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Convex Manager" <noreply@example.com>

# --- Pangolin Integration API (optional) ---
# When all four are set, the manager creates, updates and deletes each project's Pangolin resources
# through the API (PUT /v1/org/{orgId}/blueprint). Leave empty to use container labels read by Newt.
# Self-hosted: enable the Integration API first; create the key under Organization > API Keys
# (needs blueprint + resource permissions).
# PANGOLIN_API_URL=https://api.yourdomain.com
# PANGOLIN_API_KEY=
# PANGOLIN_ORG_ID=
# Identifier (niceId) of the site that can reach the project containers, shown in the Pangolin sites list
# PANGOLIN_SITE=
